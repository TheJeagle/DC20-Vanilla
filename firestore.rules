rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Creatures ─────────────────────────────────────────────────────────────
    match /VanillaCreatures/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Admin whitelist ───────────────────────────────────────────────────────
    // Each user can only read their own admin entry; no client writes.
    // Add admins manually in the Firebase console: VanillaAdmins/{uid} (empty doc).
    match /VanillaAdmins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Features ──────────────────────────────────────────────────────────────
    match /VanillaFeatures/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && exists(/databases/$(database)/documents/VanillaAdmins/$(request.auth.uid));
    }

    // ── User-made features (community sharing) ────────────────────────────────
    match /VanillaUsermadeFeatures/{featureId} {
      allow read: if true;
      // Only the author can create their own features
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      // Owner can update anything; any authenticated user can update totalLikes only
      allow update: if request.auth != null
                    && (resource.data.createdBy == request.auth.uid
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalLikes']));
      // Owner OR admin can delete
      allow delete: if request.auth != null
                    && (resource.data.createdBy == request.auth.uid
                        || exists(/databases/$(database)/documents/VanillaAdmins/$(request.auth.uid)));

      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── User data (personal feature bank) ────────────────────────────────────
    match /VanillaUsers/{userId}/featureBank/{featureId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Encounters ────────────────────────────────────────────────────────────
    match /VanillaEncounters/{docId} {
      // Allow all reads so unauthenticated users can query the collection for
      // the community page. isPublic filtering is enforced client-side, matching
      // the VanillaCreatures pattern. Write access is still owner-only.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ── Parties ───────────────────────────────────────────────────────────────
    match /VanillaParties/{docId} {
      // request.resource is unavailable during reads — split the rules
      allow read: if request.auth != null
                  && resource != null
                  && resource.data.ownerId == request.auth.uid;
      allow write: if request.auth != null
                   && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
