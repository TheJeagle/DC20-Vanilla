rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Creatures ─────────────────────────────────────────────────────────────
    match /VanillaCreatures/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Features ──────────────────────────────────────────────────────────────
    match /VanillaFeatures/{docId} {
      allow read: if true;
      allow write: if false; // admin-only via scripts
    }

    // ── Encounters ────────────────────────────────────────────────────────────
    match /VanillaEncounters/{docId} {
      // Allow all reads so unauthenticated users can query the collection for
      // the community page. isPublic filtering is enforced client-side, matching
      // the VanillaCreatures pattern. Write access is still owner-only.
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // ── Parties ───────────────────────────────────────────────────────────────
    match /VanillaParties/{docId} {
      // request.resource is unavailable during reads — split the rules
      allow read: if request.auth != null
                  && resource != null
                  && resource.data.ownerId == request.auth.uid;
      allow write: if request.auth != null
                   && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
